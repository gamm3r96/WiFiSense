# ---------- dependencies ----------
node_modules/
python-service/.venv/
python-service/venv/
python-service/__pycache__/
python-service/**/__pycache__/
*.pyc
*.pyo

# ---------- build output ----------
dist/
dist-ssr/
*.local

# ---------- logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- environment & secrets (NEVER commit) ----------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---------- editor & OS ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ---------- test & coverage ----------
coverage/
.nyc_output/

# ---------- captured data (keep repo lean) ----------
python-service/datasets/*.csv
python-service/datasets/*.json
python-service/datasets/*.npz
!python-service/datasets/.gitkeep

# ---------- serial / hardware captures ----------
*.bin
captures/
.next/
build/
